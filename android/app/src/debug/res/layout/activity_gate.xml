<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/gate_title"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/gate_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/gate_status_disabled"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/probe_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/probe_mode_initial" />

        <TextView
            android:id="@+id/probe_admission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/probe_admission_initial" />

        <TextView
            android:id="@+id/probe_callback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/probe_callback_initial" />

        <TextView
            android:id="@+id/probe_callback_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/probe_callback_duration_initial" />

        <TextView
            android:id="@+id/probe_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/probe_display_unavailable" />

        <TextView
            android:id="@+id/probe_controller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/probe_controller_initial" />

        <TextView
            android:id="@+id/probe_manual_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/probe_manual_result_initial" />

        <Button
            android:id="@+id/show_cursor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:nextFocusDown="@id/move_up"
            android:nextFocusUp="@id/accessibility_settings"
            android:text="@string/gate_show_cursor" />

        <Button
            android:id="@+id/move_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/move_down"
            android:nextFocusUp="@id/show_cursor"
            android:text="@string/gate_move_up" />

        <Button
            android:id="@+id/move_down"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/move_left"
            android:nextFocusUp="@id/move_up"
            android:text="@string/gate_move_down" />

        <Button
            android:id="@+id/move_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/move_right"
            android:nextFocusUp="@id/move_down"
            android:text="@string/gate_move_left" />

        <Button
            android:id="@+id/move_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/tap"
            android:nextFocusUp="@id/move_left"
            android:text="@string/gate_move_right" />

        <Button
            android:id="@+id/tap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/swipe_vertical"
            android:nextFocusUp="@id/move_right"
            android:text="@string/gate_tap" />

        <Button
            android:id="@+id/swipe_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/swipe_horizontal"
            android:nextFocusUp="@id/tap"
            android:text="@string/gate_swipe_vertical" />

        <Button
            android:id="@+id/swipe_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/drag_path"
            android:nextFocusUp="@id/swipe_vertical"
            android:text="@string/gate_swipe_horizontal" />

        <Button
            android:id="@+id/drag_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/cancel"
            android:nextFocusUp="@id/swipe_horizontal"
            android:text="@string/gate_drag_path" />

        <Button
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:nextFocusDown="@id/manual_activated"
            android:nextFocusUp="@id/drag_path"
            android:text="@string/gate_cancel" />

        <Button
            android:id="@+id/manual_activated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/manual_not_activated"
            android:nextFocusUp="@id/cancel"
            android:text="@string/probe_record_activated" />

        <Button
            android:id="@+id/manual_not_activated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/launch_calibration"
            android:nextFocusUp="@id/manual_activated"
            android:text="@string/probe_record_not_activated" />

        <Button
            android:id="@+id/launch_calibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/accessibility_settings"
            android:nextFocusUp="@id/manual_not_activated"
            android:text="@string/probe_launch_calibration" />

        <Button
            android:id="@+id/accessibility_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/show_cursor"
            android:nextFocusUp="@id/launch_calibration"
            android:text="@string/gate_accessibility_settings" />
    </LinearLayout>
</ScrollView>

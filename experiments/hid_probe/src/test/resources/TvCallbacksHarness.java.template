package dev.opentvtouchpad.hidprobe;
import static dev.opentvtouchpad.hidprobe.NativeRunGate.Resource.TV;
public class TvCallbacksHarness {
    static class SystemClock { static long elapsedRealtime() { return 0; } }
    static class TvRemoteClient {
        interface Listener { void needCode(); void connected(); void enrolled(TvEnrollment.Record r); void failed(); void closed(); }
        final Listener listener;
        boolean ready = true;
        TvRemoteClient(java.util.function.LongSupplier time, long deadline, Listener listener) { this.listener = listener; }
        boolean ready() { return ready; }
    }
    static class TvEnrollment {
        static class Record {}
        int saves, forgets;
        boolean accepts = true;
        boolean save(Record r) { saves++; return accepts; }
        boolean forget() { forgets++; return true; }
    }
    static class Handler {
        final java.util.ArrayDeque<Runnable> queue = new java.util.ArrayDeque<>();
        void post(Runnable r) { queue.add(r); }
        void drain() { while (!queue.isEmpty()) queue.remove().run(); }
    }
    static class Guard { long deadlineMillis() { return 300000; } }
    static class Session { boolean tvConnected(long generation) { return true; } }
    static class Status { void setText(String text) {} }
    final NativeRunGate gates = new NativeRunGate();
    final NativeRunGate.Run ownership = gates.start();
    final Handler handler = new Handler();
    final Guard guard = new Guard();
    final Session session = new Session();
    final Status status = new Status();
    final TvEnrollment tvEnrollment = new TvEnrollment();
    final long generation = 1;
    final Object target = new Object();
    final TvRemoteClient tv = createTv();
    boolean resumed = true, stopping, alive = true;
    int connects, stops;
    boolean active() { return ownership.active() && alive; }
    void updateControls() {}
    void cleanupProgress() {}
    void connect(Object peer) { connects++; }
    void stop(String message) { stopping = true; stops++; ownership.stop(); }
__CALLBACK_METHOD__
    static class Recreated {
        final NativeRunGate NATIVE_RUNS;
        final TvEnrollment tvEnrollment = new TvEnrollment();
        final Status status = new Status();
        class Run { NativeRunGate.Run ownership; }
        Run run;
        boolean pendingTvForget;
        Recreated(NativeRunGate gate) { NATIVE_RUNS = gate; }
        void clearTvCode() {}
        void stop(String message) {}
        void updateControls() {}
__FORGET_METHODS__
    }
    static void check(boolean condition) { if (!condition) throw new AssertionError(); }
    public static void main(String[] args) {
        for (int mode = 0; mode < 4; mode++) {
            TvCallbacksHarness h = new TvCallbacksHarness();
            h.tv.listener.enrolled(new TvEnrollment.Record());
            h.tv.listener.connected();
            if (mode == 0) h.stop("owner Stop");
            if (mode == 1) h.resumed = false;
            if (mode == 2) h.alive = false;
            if (mode == 3) h.tv.ready = false;
            h.handler.drain();
            check(h.tvEnrollment.saves == 0 && h.connects == 0);
        }
        TvCallbacksHarness success = new TvCallbacksHarness();
        success.tv.listener.enrolled(new TvEnrollment.Record());
        success.handler.drain();
        check(success.tvEnrollment.saves == 1 && success.stopping && success.connects == 0);
        check(!success.gates.available());
        success.tv.listener.closed();
        success.handler.drain();
        NativeRunGate.Run next = success.gates.start();
        check(next != null);
        int oldStops = success.stops;
        success.tv.listener.enrolled(new TvEnrollment.Record());
        success.tv.listener.connected();
        success.tv.listener.failed();
        success.tv.listener.closed();
        success.handler.drain();
        check(success.tvEnrollment.saves == 1 && success.stops == oldStops && next.active());
        TvCallbacksHarness failure = new TvCallbacksHarness();
        failure.tvEnrollment.accepts = false;
        failure.tv.listener.enrolled(new TvEnrollment.Record());
        failure.handler.drain();
        check(failure.stopping && failure.connects == 0);
        NativeRunGate retained = new NativeRunGate();
        NativeRunGate.Run oldActivity = retained.start();
        oldActivity.await(TV);
        oldActivity.stop();
        Recreated replacement = new Recreated(retained);
        replacement.forgetTv();
        check(!replacement.pendingTvForget && replacement.tvEnrollment.forgets == 0);
        oldActivity.completed(TV);
        replacement.forgetTv();
        check(!replacement.pendingTvForget && replacement.tvEnrollment.forgets == 1);
    }
}
